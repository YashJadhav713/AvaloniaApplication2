<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AvaloniaApplication2.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Styles>
        <FluentTheme />

        <!-- TOUCH-FRIENDLY DARK GREEN SCROLLBAR / SLIDER -->
        <Style Selector="ScrollBar:vertical">
            <Setter Property="Width" Value="26"/>
            <Setter Property="MinWidth" Value="26"/>
            <Setter Property="AllowAutoHide" Value="False"/>
            <Setter Property="Background" Value="#121212"/>
        </Style>

        <Style Selector="ScrollBar:vertical /template/ Thumb">
            <Setter Property="Background" Value="#00A844"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="MinHeight" Value="60"/>
        </Style>

        <Style Selector="ScrollBar:vertical /template/ Thumb:pointerover">
            <Setter Property="Background" Value="#00BD4C"/>
        </Style>

        <Style Selector="ScrollBar:vertical /template/ Thumb:pressed">
            <Setter Property="Background" Value="#008A37"/>
        </Style>

        <Style Selector="ScrollBar:horizontal">
            <Setter Property="Height" Value="26"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="AllowAutoHide" Value="False"/>
            <Setter Property="Background" Value="#121212"/>
        </Style>

        <Style Selector="ScrollBar:horizontal /template/ Thumb">
            <Setter Property="Background" Value="#00A844"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="MinWidth" Value="60"/>
        </Style>

        <!-- GLOBAL SMOOTH TOUCH BUTTONS -->
        <Style Selector="Button">
            <Setter Property="RenderTransform" Value="scale(1)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.08" Easing="CubicEaseOut"/>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- GLOBAL KEYPAD BUTTON SMOOTH TOUCH -->
        <Style Selector="Button.keypadButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.08" Easing="CubicEaseOut"/>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.keypadButton:pressed">
            <Setter Property="RenderTransform" Value="scale(0.92)"/>
        </Style>
    </Application.Styles>
</Application>