<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1080"
             d:DesignHeight="1920"
             x:Class="AvaloniaApplication2.Assets.Pages.ChangePasswordPage">

    <UserControl.Styles>

        <!-- PASSWORD INPUT (dark, dark green border on hover / focus) -->
        <Style Selector="TextBox.passwordBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="#00A844"/>
            <Setter Property="SelectionBrush" Value="#6600A844"/>
            <Setter Property="PlaceholderForeground" Value="#66FFFFFF"/>
        </Style>

        <Style Selector="TextBox.passwordBox /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#181818"/>
            <Setter Property="BorderBrush" Value="#005C25"/>
        </Style>

        <Style Selector="TextBox.passwordBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#181818"/>
            <Setter Property="BorderBrush" Value="#00A844"/>
        </Style>

        <Style Selector="TextBox.passwordBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#181818"/>
            <Setter Property="BorderBrush" Value="#00A844"/>
        </Style>

        <!-- KEYPAD BUTTON -->
        <Style Selector="Button.keypadButton">
            <Setter Property="Height" Value="98"/>
            <Setter Property="FontFamily" Value="Cascadia Mono"/>
            <Setter Property="FontSize" Value="42"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#181818"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#005C25"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.08" Easing="CubicEaseOut"/>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.keypadButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#0A3818"/>
            <Setter Property="BorderBrush" Value="#00C853"/>
            <Setter Property="Foreground" Value="#00FF66"/>
        </Style>

        <Style Selector="Button.keypadButton:pressed">
            <Setter Property="RenderTransform" Value="scale(0.92)"/>
        </Style>
        <Style Selector="Button.keypadButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#00A844"/>
            <Setter Property="BorderBrush" Value="#00FF66"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.keypadButton.keypadAction">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="Background" Value="#222222"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
        </Style>

        <!-- SAVE BUTTON (dark green) -->
        <Style Selector="Button.saveButton">
            <Setter Property="Background" Value="#00A844"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#00A844"/>
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>

        <Style Selector="Button.saveButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#00BD4C"/>
            <Setter Property="BorderBrush" Value="#00BD4C"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.saveButton:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)"/>
        </Style>

        <Style Selector="Button.saveButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#008A37"/>
            <Setter Property="BorderBrush" Value="#008A37"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- CANCEL BUTTON (dark with outline) -->
        <Style Selector="Button.cancelButton">
            <Setter Property="Background" Value="#121212"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#005C25"/>
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>

        <Style Selector="Button.cancelButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#072B14"/>
            <Setter Property="BorderBrush" Value="#00A844"/>
            <Setter Property="Foreground" Value="#00A844"/>
        </Style>

        <Style Selector="Button.cancelButton:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)"/>
        </Style>

        <Style Selector="Button.cancelButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#03140A"/>
            <Setter Property="BorderBrush" Value="#00A844"/>
            <Setter Property="Foreground" Value="#00A844"/>
        </Style>

    </UserControl.Styles>

    <Viewbox Stretch="Fill">
        <Canvas Width="1080"
                Height="1920"
                Background="#0A0A0A">

            <!-- PAGE TITLE -->
            <TextBlock Text="CHANGE PASSWORD"
                       FontFamily="Cascadia Mono"
                       FontSize="36"
                       FontWeight="Black"
                       LetterSpacing="4"
                       Foreground="White"
                       Width="1080"
                       TextAlignment="Center"
                       Canvas.Left="0"
                       Canvas.Top="130"/>

            <!-- TITLE SEPARATOR -->
            <Border Width="920"
                    Height="3"
                    Background="#00A844"
                    CornerRadius="2"
                    Canvas.Left="80"
                    Canvas.Top="195"/>

            <!-- CURRENT PASSWORD LABEL -->
            <TextBlock Text="Current Password"
                       FontFamily="Cascadia Mono"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#99FFFFFF"
                       Canvas.Left="80"
                       Canvas.Top="230"/>

            <!-- CURRENT PASSWORD -->
            <TextBox x:Name="CurrentPasswordBox"
                     Classes="passwordBox"
                     Width="920"
                     Height="68"
                     FontFamily="Cascadia Mono"
                     FontSize="24"
                     MaxLength="4"
                     PasswordChar="●"
                     PlaceholderText="Enter current password"
                     Background="#181818"
                     BorderBrush="#005C25"
                     BorderThickness="2"
                     CornerRadius="12"
                     Padding="18"
                     VerticalContentAlignment="Center"
                     Canvas.Left="80"
                     Canvas.Top="265"/>

            <!-- NEW PASSWORD LABEL -->
            <TextBlock Text="New Password"
                       FontFamily="Cascadia Mono"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#99FFFFFF"
                       Canvas.Left="80"
                       Canvas.Top="350"/>

            <!-- NEW PASSWORD -->
            <TextBox x:Name="NewPasswordBox"
                     Classes="passwordBox"
                     Width="920"
                     Height="68"
                     FontFamily="Cascadia Mono"
                     FontSize="24"
                     MaxLength="4"
                     PasswordChar="●"
                     PlaceholderText="Enter new password"
                     Background="#181818"
                     BorderBrush="#005C25"
                     BorderThickness="2"
                     CornerRadius="12"
                     Padding="18"
                     VerticalContentAlignment="Center"
                     Canvas.Left="80"
                     Canvas.Top="385"/>

            <!-- CONFIRM PASSWORD LABEL -->
            <TextBlock Text="Confirm New Password"
                       FontFamily="Cascadia Mono"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#99FFFFFF"
                       Canvas.Left="80"
                       Canvas.Top="470"/>

            <!-- CONFIRM PASSWORD -->
            <TextBox x:Name="ConfirmPasswordBox"
                     Classes="passwordBox"
                     Width="920"
                     Height="68"
                     FontFamily="Cascadia Mono"
                     FontSize="24"
                     MaxLength="4"
                     PasswordChar="●"
                     PlaceholderText="Confirm new password"
                     Background="#181818"
                     BorderBrush="#005C25"
                     BorderThickness="2"
                     CornerRadius="12"
                     Padding="18"
                     VerticalContentAlignment="Center"
                     Canvas.Left="80"
                     Canvas.Top="505"/>

            <!-- ON-SCREEN NUMERIC KEYPAD -->
            <Border Width="840"
                    Height="380"
                    Background="#121212"
                    BorderBrush="#005C25"
                    BorderThickness="1.5"
                    CornerRadius="18"
                    Padding="18,14"
                    Canvas.Left="120"
                    Canvas.Top="585">
                <Grid>
                    <!-- NUTRIPOD LOGO BACKGROUND (50% OPACITY) -->
                    <Image Source="/Assets/Image/NutripodLogo.png"
                           Opacity="0.5"
                           Width="420"
                           Height="260"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"/>

                    <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                          ColumnDefinitions="*,*,*"
                          RowSpacing="10"
                          ColumnSpacing="12">
                        <Button Grid.Row="0" Grid.Column="0" Content="1" Classes="keypadButton" Click="KeypadDigit_Click" Tag="1"/>
                        <Button Grid.Row="0" Grid.Column="1" Content="2" Classes="keypadButton" Click="KeypadDigit_Click" Tag="2"/>
                        <Button Grid.Row="0" Grid.Column="2" Content="3" Classes="keypadButton" Click="KeypadDigit_Click" Tag="3"/>

                        <Button Grid.Row="1" Grid.Column="0" Content="4" Classes="keypadButton" Click="KeypadDigit_Click" Tag="4"/>
                        <Button Grid.Row="1" Grid.Column="1" Content="5" Classes="keypadButton" Click="KeypadDigit_Click" Tag="5"/>
                        <Button Grid.Row="1" Grid.Column="2" Content="6" Classes="keypadButton" Click="KeypadDigit_Click" Tag="6"/>

                        <Button Grid.Row="2" Grid.Column="0" Content="7" Classes="keypadButton" Click="KeypadDigit_Click" Tag="7"/>
                        <Button Grid.Row="2" Grid.Column="1" Content="8" Classes="keypadButton" Click="KeypadDigit_Click" Tag="8"/>
                        <Button Grid.Row="2" Grid.Column="2" Content="9" Classes="keypadButton" Click="KeypadDigit_Click" Tag="9"/>

                        <Button Grid.Row="3" Grid.Column="0" Content="CLR" Classes="keypadButton keypadAction" Click="KeypadClear_Click"/>
                        <Button Grid.Row="3" Grid.Column="1" Content="0" Classes="keypadButton" Click="KeypadDigit_Click" Tag="0"/>
                        <Button Grid.Row="3" Grid.Column="2" Content="⌫" Classes="keypadButton keypadAction" Click="KeypadBackspace_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- STATUS -->
            <TextBlock x:Name="StatusText"
                       Width="920"
                       FontFamily="Cascadia Mono"
                       FontSize="18"
                       FontWeight="Bold"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Foreground="#FF5252"
                       Canvas.Left="80"
                       Canvas.Top="980"/>

            <!-- SAVE BUTTON -->
            <Button x:Name="SaveButton"
                    Classes="saveButton"
                    Content="SAVE"
                    Canvas.Left="80"
                    Canvas.Top="1025"
                    Width="445"
                    Height="85"
                    FontFamily="Cascadia Mono"
                    FontSize="22"
                    FontWeight="Black"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    BorderThickness="2"
                    CornerRadius="14"/>

            <!-- CANCEL BUTTON -->
            <Button x:Name="CancelButton"
                    Classes="cancelButton"
                    Content="CANCEL"
                    Canvas.Left="555"
                    Canvas.Top="1025"
                    Width="445"
                    Height="85"
                    FontFamily="Cascadia Mono"
                    FontSize="22"
                    FontWeight="Bold"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    BorderThickness="2"
                    CornerRadius="14"/>

            <!-- BOTTOM ACCENT -->
            <Border Width="920"
                    Height="5"
                    Background="#00A844"
                    CornerRadius="3"
                    Canvas.Left="80"
                    Canvas.Top="1135"/>

        </Canvas>
    </Viewbox>

</UserControl>
