<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AvaloniaApplication2.Assets.Pages.EditImageWindow"
        Title="EDIT IMAGE"
        Width="850"
        Height="650"
        MinWidth="800"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="#0A0A0A"
        CanResize="False">

    <!-- ============================================================= -->
    <!-- THEME                                                         -->
    <!--   BLACK      #0A0A0A (page)   #121212 (panels)                -->
    <!--   DARK GREEN #00A844 (highlights)                             -->
    <!--   BORDER     #005C25 (outlines)                               -->
    <!--   WHITE      text (labels use white at 60% = #99FFFFFF)        -->
    <!-- ============================================================= -->

    <Window.Styles>

        <!-- SAVE BUTTON (dark green) -->

        <Style Selector="Button.saveButton">
            <Setter Property="Background" Value="#00A844"/>
            <Setter Property="Foreground" Value="#0A0A0A"/>
            <Setter Property="BorderBrush" Value="#00A844"/>
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
        </Style>

        <Style Selector="Button.saveButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#00BD4C"/>
            <Setter Property="BorderBrush" Value="#00BD4C"/>
            <Setter Property="Foreground" Value="#0A0A0A"/>
        </Style>

        <Style Selector="Button.saveButton:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)"/>
        </Style>

        <Style Selector="Button.saveButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#008A37"/>
            <Setter Property="BorderBrush" Value="#008A37"/>
            <Setter Property="Foreground" Value="#0A0A0A"/>
        </Style>

        <Style Selector="Button.saveButton:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#005C25"/>
            <Setter Property="BorderBrush" Value="#005C25"/>
            <Setter Property="Foreground" Value="#707070"/>
        </Style>


        <!-- CANCEL / EDIT BUTTONS (dark with outline) -->

        <Style Selector="Button.cancelButton">
            <Setter Property="Background" Value="#121212"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#005C25"/>
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
        </Style>

        <Style Selector="Button.editButton">
            <Setter Property="Background" Value="#121212"/>
            <Setter Property="Foreground" Value="#00A844"/>
            <Setter Property="BorderBrush" Value="#00A844"/>
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
        </Style>

        <Style Selector="Button.cancelButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#072B14"/>
            <Setter Property="BorderBrush" Value="#00A844"/>
            <Setter Property="Foreground" Value="#00A844"/>
        </Style>

        <Style Selector="Button.editButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#072B14"/>
            <Setter Property="BorderBrush" Value="#00A844"/>
            <Setter Property="Foreground" Value="#00A844"/>
        </Style>

        <Style Selector="Button.cancelButton:pressed, Button.editButton:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)"/>
        </Style>

        <Style Selector="Button.cancelButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#04180B"/>
            <Setter Property="BorderBrush" Value="#00A844"/>
            <Setter Property="Foreground" Value="#00A844"/>
        </Style>

        <Style Selector="Button.editButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#04180B"/>
            <Setter Property="BorderBrush" Value="#00A844"/>
            <Setter Property="Foreground" Value="#00A844"/>
        </Style>

        <Style Selector="Button.editButton:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#121212"/>
            <Setter Property="BorderBrush" Value="#005C25"/>
            <Setter Property="Foreground" Value="#707070"/>
        </Style>

    </Window.Styles>

    <Viewbox Stretch="Uniform">
        <Canvas Width="1200"
                Height="800"
                Background="#0A0A0A">

            <!-- TITLE -->
            <TextBlock Text="EDIT IMAGE"
                       FontFamily="Cascadia Mono"
                       FontSize="44"
                       FontWeight="Black"
                       Foreground="White"
                       Canvas.Left="60"
                       Canvas.Top="50"/>

            <!-- FIXED DRINK ID -->
            <TextBlock x:Name="DrinkIdText"
                       Text="DRINK ID: 1"
                       FontFamily="Cascadia Mono"
                       FontSize="28"
                       FontWeight="Black"
                       Foreground="#00A844"
                       Canvas.Left="60"
                       Canvas.Top="115"/>

            <!-- DIVIDER -->
            <Border Width="1080"
                    Height="3"
                    Background="#00A844"
                    CornerRadius="2"
                    Canvas.Left="60"
                    Canvas.Top="165"/>

            <!-- IMAGE PREVIEW -->
            <Border Width="500"
                    Height="500"
                    Background="#121212"
                    BorderBrush="#005C25"
                    BorderThickness="2"
                    CornerRadius="22"
                    Canvas.Left="60"
                    Canvas.Top="200">

                <Image x:Name="DrinkImagePreview"
                       Stretch="Uniform"
                       Margin="18"/>
            </Border>

            <!-- RIGHT PANEL -->
            <!-- IMAGE STATUS -->
            <TextBlock x:Name="StatusText"
                       Width="540"
                       Height="60"
                       FontFamily="Cascadia Mono"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#00A844"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       VerticalAlignment="Center"
                       Canvas.Left="600"
                       Canvas.Top="220"/>

            <!-- NEW IMAGE -->
            <Button x:Name="NewImageButton"
                    Classes="editButton"
                    Width="540"
                    Height="80"
                    BorderThickness="2"
                    CornerRadius="16"
                    FontFamily="Cascadia Mono"
                    FontSize="24"
                    FontWeight="Bold"
                    Content="SELECT NEW IMAGE"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Canvas.Left="600"
                    Canvas.Top="300"/>

            <!-- RESET TO DEFAULT -->
            <Button x:Name="ResetDefaultButton"
                    Classes="cancelButton"
                    Width="540"
                    Height="80"
                    BorderThickness="2"
                    CornerRadius="16"
                    FontFamily="Cascadia Mono"
                    FontSize="24"
                    FontWeight="Bold"
                    Content="RESTORE DEFAULT IMAGE"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Canvas.Left="600"
                    Canvas.Top="395"/>

            <!-- SAVE -->
            <Button x:Name="SaveButton"
                    Classes="saveButton"
                    Width="255"
                    Height="80"
                    BorderThickness="2"
                    CornerRadius="16"
                    FontFamily="Cascadia Mono"
                    FontSize="24"
                    FontWeight="Black"
                    Content="SAVE"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    IsEnabled="False"
                    Canvas.Left="600"
                    Canvas.Top="490"/>

            <!-- CANCEL -->
            <Button x:Name="CancelButton"
                    Classes="cancelButton"
                    Width="255"
                    Height="80"
                    BorderThickness="2"
                    CornerRadius="16"
                    FontFamily="Cascadia Mono"
                    FontSize="24"
                    FontWeight="Bold"
                    Content="CANCEL"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Canvas.Left="885"
                    Canvas.Top="490"/>

        </Canvas>
    </Viewbox>
</Window>
